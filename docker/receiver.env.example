# Settings for the `receiver` compose profile (ultrafeeder and dump978). See docs/RECEIVER.md.
#   cp docker/receiver.env.example receiver.env
# receiver.env is in .gitignore: it says where your antenna is.

# Where the antenna is. Decimal degrees; height above sea level in metres.
FEEDER_LAT=
FEEDER_LONG=
FEEDER_ALT_M=

# Serial number of the dongle on 1090 MHz. Leave empty when only one dongle is plugged in.
ADSB_SDR_SERIAL=
ADSB_SDR_GAIN=auto

# Second dongle, on 978 MHz (UAT, USA only). Give the two dongles different serial numbers.
UAT_SDR_SERIAL=
UAT_SDR_GAIN=autogain

# Have ultrafeeder take the UAT data from dump978. Leave empty when you run ultrafeeder alone.
ULTRAFEEDER_CONFIG=adsb,dump978,30978,uat_in

# Host port for ultrafeeder's own map.
ULTRAFEEDER_PORT=8080
