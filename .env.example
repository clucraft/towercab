# TowerCab environment variables. Copy to .env and fill in what you need.
# Everything is optional: with no values at all the app runs in Schematic mode on public ADS-B data.

# --- Server ---------------------------------------------------------------
# Port the server listens on inside the container.
PORT=8790
# Public URL of the app when it sits behind a reverse proxy, e.g. https://towercab.example.com
PUBLIC_URL=
# Time zone for log timestamps and the UI clock, e.g. America/Indiana/Indianapolis
TZ=UTC
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- 3D imagery (sent to the browser by design; restrict them to your hostname) --
# Free Cesium ion token: enables Google Photorealistic 3D Tiles through ion, and Cesium World Terrain.
CESIUM_ION_TOKEN=
# Optional: Google Map Tiles API key, used instead of ion for Photorealistic 3D Tiles.
GOOGLE_MAPS_API_KEY=

# --- adsb.lol (optional) ------------------------------------------------------
# Without a key adsb.lol allows 500 requests a day per IP. A free key raises that.
# Get one at https://www.adsb.lol/mmb
ADSBLOL_API_KEY=

# --- OpenSky Network (optional fallback source; OAuth2 client credentials) ---
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Camera discovery (optional, admin only) --------------------------------
YOUTUBE_API_KEY=
WINDY_API_KEY=

# --- Admin ------------------------------------------------------------------
# Enables /admin and the admin API. Leave empty to switch all admin routes off.
ADMIN_TOKEN=
