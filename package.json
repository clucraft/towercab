{
  "name": "towercab",
  "version": "0.0.0",
  "private": true,
  "description": "Live aircraft around an airport in a 3D scene, like the view from the tower cab.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @towercab/web build && pnpm --filter @towercab/server build",
    "start": "node apps/server/dist/index.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "soak": "tsx scripts/soak.ts",
    "gen:models": "tsx scripts/gen-models.ts",
    "probe": "tsx scripts/probe.ts",
    "verify:scene": "tsx scripts/verify-scene.ts",
    "verify:surface": "tsx scripts/verify-surface.ts",
    "profile:phone": "tsx scripts/phone-profile.ts",
    "check:types": "tsx scripts/check-type-articles.ts",
    "test:e2e": "playwright test",
    "record": "tsx scripts/record.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@gltf-transform/core": "4.5.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
